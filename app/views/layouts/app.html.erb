<!DOCTYPE html>
<html>
  <head>
    <%= render "shared/head" %>
  </head>

  <body class="min-h-dvh bg-paper text-ink overflow-x-hidden" data-controller="mobile-nav">
    <div class="flex flex-col min-h-dvh md:flex-row">
      <!-- Mobile top bar (below md) -->
      <header class="md:hidden sticky top-0 z-40 flex items-center justify-between gap-3 px-4 py-3 border-b-4 border-ink bg-ink text-paper">
        <%= link_to current_user.home_path, class: "font-display font-black text-lg tracking-tight text-yellow leading-none" do %>
          MENUCITO
        <% end %>
        <button type="button" data-action="mobile-nav#open"
                class="flex items-center justify-center min-h-12 min-w-12 border-2 border-paper/40 text-paper"
                aria-label="Abrir menú">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
        </button>
      </header>

      <!-- Mobile nav drawer (full-screen overlay) -->
      <div data-mobile-nav-target="panel"
           class="hidden md:hidden fixed inset-0 z-50 bg-ink text-paper flex flex-col">
        <div class="flex items-center justify-between p-4 border-b-4 border-paper/20">
          <div>
            <p class="font-display font-black text-lg tracking-tight text-yellow leading-none">MENUCITO</p>
            <p class="text-[11px] uppercase tracking-widest text-paper/60 mt-0.5"><%= current_restaurant&.name %></p>
          </div>
          <button type="button" data-action="mobile-nav#close"
                  class="flex items-center justify-center min-h-12 min-w-12 border-2 border-paper/40 text-paper"
                  aria-label="Cerrar menú">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
            </svg>
          </button>
        </div>

        <nav class="flex flex-col flex-1 overflow-y-auto text-base font-bold uppercase tracking-wide">
          <% if current_user.can_sell_at_counter? %>
            <%= render "shared/nav_link", label: "Ventas", path: pos_path, active: controller_name == "pos" %>
          <% end %>
          <% if current_user.front_of_house? %>
            <%= render "shared/nav_link", label: "Mesas", path: dining_tables_path, active: controller_name == "dining_tables" %>
          <% end %>
          <% if current_user.kitchen_access? %>
            <%= render "shared/nav_link", label: "Cocina", path: kitchen_path, active: controller_name == "kitchen" %>
          <% end %>
          <% if current_user.can_manage_cash? %>
            <%= render "shared/nav_link", label: "Caja", path: cash_sessions_path, active: controller_name.in?(%w[cash_sessions cash_movements]) %>
          <% end %>
          <% if current_user.can_manage_restaurant? %>
            <%= render "shared/nav_link", label: "Categorías", path: menu_categories_path, active: controller_name == "menu_categories" %>
            <%= render "shared/nav_link", label: "Platos", path: menu_items_path, active: controller_name == "menu_items" %>
            <%= render "shared/nav_link", label: "Descuentos", path: discounts_path, active: controller_name == "discounts" %>
            <%= render "shared/nav_link", label: "Usuarios", path: users_path, active: controller_name == "users" %>
            <%= render "shared/nav_link", label: "Ajustes", path: edit_restaurant_settings_path, active: controller_name == "restaurant_settings" %>
          <% end %>
        </nav>

        <div class="p-4 border-t-4 border-paper/20 text-xs">
          <p class="font-bold"><%= current_user&.name %></p>
          <p class="text-paper/60 uppercase tracking-widest mb-3"><%= role_label(current_user.role) if current_user %></p>
          <%= button_to "Salir", destroy_user_session_path, method: :delete,
                form: { data: { controller: "confirm", turbo: false,
                                confirm_title_value: "¿Cerrar sesión?",
                                confirm_message_value: "Vas a salir de #{current_restaurant&.name}.",
                                confirm_confirm_label_value: "Sí, salir" } },
                class: "btn-secondary !bg-transparent !text-paper !border-paper w-full !py-3" %>
        </div>
      </div>

      <!-- Desktop sidebar (md and up) -->
      <header class="hidden md:flex md:w-56 shrink-0 border-r-4 border-ink bg-ink text-paper md:flex-col md:h-screen md:sticky md:top-0 md:self-start md:overflow-hidden">
        <div class="p-4 border-b-4 border-paper/20">
          <%= link_to current_user.home_path, class: "font-display font-black text-xl tracking-tight text-yellow" do %>
            MENUCITO
          <% end %>
          <p class="text-[11px] uppercase tracking-widest text-paper/60 mt-0.5"><%= current_restaurant&.name %></p>
        </div>

        <nav class="flex flex-col flex-1 overflow-y-auto text-sm font-bold uppercase tracking-wide">
          <% if current_user.can_sell_at_counter? %>
            <%= render "shared/nav_link", label: "Ventas", path: pos_path, active: controller_name == "pos" %>
          <% end %>
          <% if current_user.front_of_house? %>
            <%= render "shared/nav_link", label: "Mesas", path: dining_tables_path, active: controller_name == "dining_tables" %>
          <% end %>
          <% if current_user.kitchen_access? %>
            <%= render "shared/nav_link", label: "Cocina", path: kitchen_path, active: controller_name == "kitchen" %>
          <% end %>
          <% if current_user.can_manage_cash? %>
            <%= render "shared/nav_link", label: "Caja", path: cash_sessions_path, active: controller_name.in?(%w[cash_sessions cash_movements]) %>
          <% end %>
          <% if current_user.can_manage_restaurant? %>
            <%= render "shared/nav_link", label: "Categorías", path: menu_categories_path, active: controller_name == "menu_categories" %>
            <%= render "shared/nav_link", label: "Platos", path: menu_items_path, active: controller_name == "menu_items" %>
            <%= render "shared/nav_link", label: "Descuentos", path: discounts_path, active: controller_name == "discounts" %>
            <%= render "shared/nav_link", label: "Usuarios", path: users_path, active: controller_name == "users" %>
            <%= render "shared/nav_link", label: "Ajustes", path: edit_restaurant_settings_path, active: controller_name == "restaurant_settings" %>
          <% end %>
        </nav>

        <div class="p-4 border-t-4 border-paper/20 text-xs">
          <p class="font-bold"><%= current_user&.name %></p>
          <p class="text-paper/60 uppercase tracking-widest mb-2"><%= role_label(current_user.role) if current_user %></p>
          <%= button_to "Salir", destroy_user_session_path, method: :delete,
                form: { data: { controller: "confirm", turbo: false,
                                confirm_title_value: "¿Cerrar sesión?",
                                confirm_message_value: "Vas a salir de #{current_restaurant&.name}.",
                                confirm_confirm_label_value: "Sí, salir" } },
                class: "btn-secondary !bg-transparent !text-paper !border-paper w-full text-xs !py-2" %>
        </div>
      </header>

      <div class="flex-1 min-w-0 p-4 md:p-8 max-w-6xl mx-auto w-full">
        <%= render "shared/flashes" %>
        <main class="md:overflow-y-auto">
        <%= yield %>
        </main>
      </div>
    </div>
  </body>
</html>
