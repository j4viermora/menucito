<%= form_with model: user, class: "nb-box p-6 max-w-md",
      data: { controller: "validate", action: "submit->validate#submit" } do |f| %>
  <%= render "shared/error_messages", resource: user %>

  <div class="mb-4">
    <%= f.label :name, "Nombre", class: "field-label" %>
    <%= f.text_field :name, id: "user_form_name", class: "field-input",
          data: { validate_target: "field", validate_rule: "required", action: "blur->validate#check" } %>
    <p class="field-error hidden" data-validate-for="user_form_name"></p>
  </div>

  <div class="mb-4">
    <%= f.label :email, "Correo", class: "field-label" %>
    <%= f.email_field :email, id: "user_form_email", class: "field-input",
          data: { validate_target: "field", validate_rule: "required,email", action: "blur->validate#check" } %>
    <p class="field-error hidden" data-validate-for="user_form_email"></p>
  </div>

  <div class="mb-4">
    <%= f.label :role, "Rol", class: "field-label" %>
    <%= f.select :role, User.roles.keys.map { |k| [ role_label(k), k ] }, {}, class: "field-input" %>
  </div>

  <div class="mb-4">
    <%= f.label :password, user.new_record? ? "Contraseña" : "Nueva contraseña (opcional)", class: "field-label" %>
    <%= f.password_field :password, id: "user_form_password", class: "field-input", autocomplete: "new-password",
          data: user.new_record? ? { validate_target: "field", validate_rule: "required,minlength:6", action: "blur->validate#check" } : {} %>
    <p class="field-error hidden" data-validate-for="user_form_password"></p>
  </div>

  <label class="mb-6 flex items-center gap-3 min-h-12 -mx-2 px-2 cursor-pointer">
    <%= f.check_box :active, class: "size-5 shrink-0 border-4 border-ink rounded-none" %>
    <span class="field-label mb-0">Activo</span>
  </label>

  <%= f.submit "Guardar usuario", class: "btn-primary w-full" %>
<% end %>
