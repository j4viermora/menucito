<div class="flex items-center justify-between mb-6">
  <h1 class="nb-heading text-2xl">Usuarios</h1>
  <%= link_to "Nuevo usuario", new_user_path, class: "btn-primary text-xs" %>
</div>

<div class="nb-box divide-y-4 divide-ink">
  <% @users.each do |user| %>
    <div class="flex items-center justify-between p-4">
      <div>
        <p class="font-bold"><%= user.name %></p>
        <p class="text-xs text-ink/60"><%= user.email %></p>
      </div>
      <div class="flex items-center gap-2">
        <span class="badge badge-outline"><%= user.role %></span>
        <span class="badge <%= user.active? ? 'badge-mint' : 'badge-outline' %>"><%= user.active? ? "Activo" : "Inactivo" %></span>
        <%= link_to "Editar", edit_user_path(user), class: "btn-secondary text-xs !px-3 !py-2" %>
        <% unless user == current_user %>
          <%= button_to "Eliminar", user_path(user), method: :delete,
                form: { data: { controller: "confirm", confirm_title_value: "¿Eliminar a #{user.name}?",
                                confirm_message_value: "Perderá acceso al panel inmediatamente." } },
                class: "btn-secondary text-xs !px-3 !py-2 !text-red !border-red" %>
        <% end %>
      </div>
    </div>
  <% end %>
</div>
