<%= form_with model: menu_category, class: "nb-box p-6 max-w-md",
      data: { controller: "validate", action: "submit->validate#submit" } do |f| %>
  <%= render "shared/error_messages", resource: menu_category %>

  <div class="mb-4">
    <%= f.label :name, "Nombre", class: "field-label" %>
    <%= f.text_field :name, id: "menu_category_name", class: "field-input",
          data: { validate_target: "field", validate_rule: "required", action: "blur->validate#check" } %>
    <p class="field-error hidden" data-validate-for="menu_category_name"></p>
  </div>

  <label class="mb-6 flex items-center gap-3 min-h-12 -mx-2 px-2 cursor-pointer">
    <%= f.check_box :active, class: "size-5 shrink-0 border-4 border-ink rounded-none" %>
    <span class="field-label mb-0">Visible en la carta</span>
  </label>

  <%= f.submit "Guardar categoría", class: "btn-primary w-full" %>
<% end %>
