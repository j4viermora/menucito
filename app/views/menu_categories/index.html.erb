<div class="flex items-center justify-between mb-6">
  <h1 class="nb-heading text-2xl">Categorías</h1>
  <%= link_to "Nueva categoría", new_menu_category_path, class: "btn-primary text-xs" %>
</div>

<% if @menu_categories.empty? %>
  <div class="nb-box p-8 text-center text-ink/60">Aún no tienes categorías.</div>
<% else %>
  <div class="nb-box divide-y-4 divide-ink">
    <% @menu_categories.each do |category| %>
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 p-4">
        <div class="min-w-0">
          <p class="font-bold truncate"><%= category.name %></p>
          <p class="text-xs text-ink/60"><%= pluralize(category.menu_items.size, "plato") %> · <%= category.active? ? "Activa" : "Oculta" %></p>
        </div>
        <div class="flex flex-wrap gap-2">
          <%= link_to "Editar", edit_menu_category_path(category), class: "btn-secondary text-xs !px-3 !py-2" %>
          <%= button_to "Eliminar", menu_category_path(category), method: :delete,
                form: { data: { controller: "confirm", confirm_title_value: "¿Eliminar #{category.name}?",
                                confirm_message_value: "Los platos de esta categoría también podrían verse afectados." } },
                class: "btn-secondary text-xs !px-3 !py-2 !text-red !border-red" %>
        </div>
      </div>
    <% end %>
  </div>
<% end %>
