<div class="flex items-center justify-between mb-6">
  <h1 class="nb-heading text-2xl">Descuentos</h1>
  <%= link_to "Nuevo descuento", new_discount_path, class: "btn-primary text-xs" %>
</div>

<% if @discounts.empty? %>
  <div class="nb-box p-8 text-center text-ink/60">Aún no tienes descuentos configurados.</div>
<% else %>
  <div class="nb-box divide-y-4 divide-ink">
    <% @discounts.each do |discount| %>
      <div class="flex items-center justify-between p-4">
        <div>
          <p class="font-bold"><%= discount.name %></p>
          <p class="text-xs text-ink/60">
            <%= discount.percentage? ? "#{discount.value.to_i}%" : number_to_currency(discount.value, unit: current_restaurant.currency + " ", precision: 0) %>
            <% if discount.requires_authorization? %> · requiere autorización<% end %>
          </p>
        </div>
        <div class="flex items-center gap-2">
          <span class="badge <%= discount.active? ? 'badge-mint' : 'badge-outline' %>"><%= discount.active? ? "Activo" : "Inactivo" %></span>
          <%= link_to "Editar", edit_discount_path(discount), class: "btn-secondary text-xs !px-3 !py-2" %>
          <%= button_to "Eliminar", discount_path(discount), method: :delete,
                form: { data: { controller: "confirm", confirm_title_value: "¿Eliminar #{discount.name}?",
                                confirm_message_value: "Esta acción no se puede deshacer." } },
                class: "btn-secondary text-xs !px-3 !py-2 !text-red !border-red" %>
        </div>
      </div>
    <% end %>
  </div>
<% end %>
